{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES6",
		"moduleResolution": "bundler",
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictBindCallApply": true,
		"importHelpers": true,
		"isolatedModules": true,
		"types": [],
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2021"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}
